        220,
        300
      ],
      "notes": "Único sitio (por workflow) con la URL de Supabase y el remitente. La clave service_role NO va aquí: está en la credencial \"Supabase turnos (service role)\".",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuración').first().json.supabase_url }}/rest/v1/rpc/create_link",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_slug: $('Formulario de enlaces').first().json.slug, p_destination: $('Formulario de enlaces').first().json.destino ?? null, p_channel: $('Formulario de enlaces').first().json.canal ?? null }) }}",
        "options": {}
      },
      "id": "crear-enlace",
      "name": "Crear enlace",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
