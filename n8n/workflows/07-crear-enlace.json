    {
      "parameters": {
        "jsCode": "// Mensaje de «Enlace creado». Todo viene de create_link (destino ya validado), no del formulario.\nconst r = $input.first().json;\nconst mensaje = [\n  `Tu enlace corto ya funciona:`,\n  ``,\n  `${r.short_url}`,\n  ``,\n  `Redirige a: ${r.destination}`,\n  `Canal en las estadísticas: ${r.channel}`,\n  ``,\n  `Las reservas hechas desde este enlace se guardan con origen «${r.slug}».`,\n].join('\\n');\nreturn [{ json: { mensaje } }];\n"
      },
      "id": "mensaje-final",
      "name": "Mensaje final",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        40
