{
  "id": "turnosCrearEnlace1",
  "name": "Turnos · 07 Crear enlace corto",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "authentication": "basicAuth",
        "formTitle": "Crear enlace corto",
        "formDescription": "Crea un enlace corto para una campaña o canal (por ejemplo, instagram). Las reservas hechas desde él se cuentan en las estadísticas. El slug solo admite minúsculas, números y guiones.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Slug",
              "fieldName": "slug",
              "fieldType": "text",
              "requiredField": true,
              "placeholder": "instagram"
            },
            {
              "fieldLabel": "Destino (opcional)",
              "fieldName": "destino",
              "fieldType": "text",
              "placeholder": "Vacío = el formulario de reserva"
            },
            {
              "fieldLabel": "Canal (opcional)",
              "fieldName": "canal",
              "fieldType": "text",
              "placeholder": "Vacío = el slug. Ej.: instagram"
            }
          ]
        },
        "responseMode": "onReceived",
        "options": {
          "path": "crear-enlace",
          "buttonLabel": "Crear enlace",
          "appendAttribution": false
        }
      },
      "id": "formulario-de-enlaces",
      "name": "Formulario de enlaces",
