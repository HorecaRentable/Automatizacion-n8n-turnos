    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuración').first().json.supabase_url }}/rest/v1/rpc/resolve_link",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_slug: String($('Enlace corto').first().json.params.slug ?? '').slice(0, 100).replace(/[^ -~]/g, '') }) }}",
        "options": {}
      },
      "id": "resolver-enlace",
      "name": "Resolver enlace",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "credentials": {
        "supabaseApi": {
          "id": "supabaseTurnos1",
          "name": "Supabase turnos (service role)"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Decide a dónde redirigir y si este clic cuenta. La redirección NUNCA espera al recuento (va después, ver workflow 06).\r\n//   · resolve_link ya devuelve un destino VALIDADO (dominio permitido + origen=<slug>); aquí no se construye ni se toca ninguna URL.\r\n//   · Si Supabase no responde, se redirige a la página de respaldo de «Configuración»: nadie se queda sin redirección.\r\n//   · Si resolve_link responde pero no hay ni página por defecto válida (url = null), no hay Location: se responde 404.\r\n//   · Cuenta solo si el enlace existe (found) y la visita parece de una persona: a los previsualizadores de enlaces,\r\n//     rastreadores, monitores y herramientas de línea de comandos se les redirige igual (la vista previa funciona), pero no suman.\r\nconst r = $input.first().json;\r\nconst conf = $('Configuración').first().json;\r\nconst req = $('Enlace corto').first().json;\r\nconst ua = String(req.headers?.['user-agent'] ?? '');\r\n\r\nconst BOT = /bot\\b|crawler|spider|slurp|preview|facebookexternalhit|facebot|embedly|bitlybot|whatsapp\\/|telegrambot|skypeuripreview|discordbot|slackbot|twitterbot|linkedinbot|pinterest|vkshare|headlesschrome|phantomjs|lighthouse|curl\\/|wget\\/|python-requests|python-urllib|go-http-client|java\\/|okhttp\\/|libwww|httpclient|axios\\/|node-fetch|undici|^node$|monitor|uptime|pingdom|statuscake/i;\r\nconst human = ua.length > 0 && !BOT.test(ua);\r\n\r\nconst respondio = r && r.ok === true && !r.error;       // false = Supabase caído / error de red\r\nlet location = respondio ? (r.url ?? null) : conf.url_respaldo;\r\n// Última barrera (el SQL ya lo garantiza): solo http(s) y caracteres imprimibles, nunca saltos de línea en la cabecera\r\nif (location !== null && !/^https?:\\/\\/[!-~]+$/.test(String(location))) location = null;\r\n\r\nreturn [{ json: {\r\n  location,\r\n  slug: respondio && r.found === true ? r.slug : null,\r\n  count: respondio && r.found === true && human && location !== null,\r\n  human,\r\n} }];\r\n"
      },
      "id": "preparar-redirecci-n",
      "name": "Preparar redirección",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
