# Copia este archivo como ".env" y ajusta los valores.

# Puerto donde se abrirá nuestra web
PORT=3000

# URL del webhook de n8n.
# - "webhook-test" funciona SOLO mientras pulsas "Listen for test event" en n8n (para probar)
# - "webhook" funciona cuando el workflow está ACTIVADO (modo producción)
N8N_WEBHOOK_URL=http://localhost:5678/webhook-test/hola
